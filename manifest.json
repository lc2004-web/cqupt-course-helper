{
  "manifest_version": 3,
  "name": "CQUPT 研究生选课辅助器",
  "version": "2.6.2",
  "description": "从培养方案导入课程并核对最低学分，自动过滤校本部硕士统一分班课程，支持教师与教学班偏好；最终提交由用户确认。",
  "permissions": [
    "activeTab",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://gs.cqupt.edu.cn/*",
    "https://ids.cqupt.edu.cn/*",
    "https://i.cqupt.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CQUPT 选课辅助器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gs.cqupt.edu.cn/*"
      ],
      "js": [
        "course-policy.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://ids.cqupt.edu.cn/authserver/login*"
      ],
      "js": [
        "login.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://i.cqupt.edu.cn/*"
      ],
      "js": [
        "portal.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
